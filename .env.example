## Copy this file to `.env` for local development.
## In EAS Build, define the same EXPO_PUBLIC_* variables in the matching environment.
## The dynamic Expo config also embeds these public values into expo.extra.publicRuntimeEnv
## so release builds and emergency OTA fallbacks can still resolve runtime configuration.
## Do not commit `.env`; keep real values only in local files or Expo environments.

EXPO_PUBLIC_APP_ENV=development

# Backend host shared by REST and GraphQL HTTP
EXPO_PUBLIC_BACKEND_URL=https://api-dev.inmigreat.com

# WebSocket origin for case updates and GraphQL subscriptions
EXPO_PUBLIC_BACKEND_WS_URL=wss://api-dev.inmigreat.com

# Backend paths
EXPO_PUBLIC_GRAPHQL_PATH=/graphql
EXPO_PUBLIC_CASES_WS_PATH=/ws
EXPO_PUBLIC_HEALTH_PATH=/health

# Public Cognito configuration used by the mobile client
EXPO_PUBLIC_COGNITO_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
EXPO_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Develop example: https://auth-dev.inmigreat.com
# Production example: https://auth.inmigreat.com
EXPO_PUBLIC_COGNITO_HOSTED_UI_URL=https://auth-dev.inmigreat.com

# Optional override for the mobile redirect URI used by Cognito Hosted UI.
# Must match one of the mobile callback URLs configured in the Cognito app client.
EXPO_PUBLIC_COGNITO_REDIRECT_URI=inmigreat://

# Optional Sentry DSN for runtime crash reporting in release builds
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000

# Build-only Sentry configuration for sourcemap upload.
# Configure these in EAS environments or CI, not in committed local files.
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
# SENTRY_AUTH_TOKEN=sntrys_your_auth_token