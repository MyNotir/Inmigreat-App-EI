{
  "name": "inmigreat-app",
  "version": "2.0.13",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:mcp": "EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "test": "jest",
    "test:watch": "jest --watch",
    "brand:assets:deps": "python3 -m pip install -r ./scripts/requirements-brand-assets.txt",
    "brand:assets": "python3 ./scripts/generate-brand-assets.py",
    "start:dev-client": "zsh ./scripts/start-dev-client-metro.sh",
    "start:dev-client:mcp": "EXPO_UNSTABLE_MCP_SERVER=1 zsh ./scripts/start-dev-client-metro.sh",
    "dev-client:up": "zsh ./scripts/run-all-dev-clients.sh",
    "android": "expo run:android",
    "android:dev-client": "zsh ./scripts/start-android-dev-client.sh",
    "android:build:local": "zsh ./scripts/build-android-dev-client.sh",
    "ios": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo start --ios",
    "ios:dev-client": "zsh ./scripts/start-ios-dev-client.sh",
    "ios:build": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo run:ios",
    "ios:build:local": "zsh ./scripts/build-ios-dev-client.sh",
    "dev-client:open:all": "zsh ./scripts/start-ios-dev-client.sh && zsh ./scripts/start-android-dev-client.sh",
    "dev-client:build:all": "zsh ./scripts/build-all-dev-clients.sh",
    "web": "expo start --web",
    "build:ios:production": "npx eas build --platform ios --profile production --auto-submit",
    "build:android:production": "npx eas build --platform android --profile production",
    "build:stores:production": "npx eas build --platform all --profile production --auto-submit",
    "build:all:devices": "npx eas build --profile developmentDevices --platform all",
    "build:ios:devices": "npx eas build --profile developmentDevices --platform ios",
    "build:android:devices": "npx eas build --profile developmentDevices --platform android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.15.7",
    "@react-navigation/native": "^7.2.0",
    "@react-navigation/stack": "^7.8.7",
    "@sentry/react-native": "~7.11.0",
    "babel-preset-expo": "^55.0.12",
    "expo": "~55.0.9",
    "expo-apple-authentication": "~55.0.9",
    "expo-auth-session": "~55.0.14",
    "expo-blur": "~55.0.10",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "~55.0.19",
    "expo-device": "~55.0.10",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.9",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.9",
    "expo-local-authentication": "~55.0.9",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.14",
    "expo-secure-store": "~55.0.9",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.16",
    "expo-web-browser": "~55.0.14",
    "graphql": "^16.13.2",
    "graphql-ws": "^6.0.8",
    "i18next": "^26.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.4",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "expo-mcp": "~0.2.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ]
  }
}
