{
  "expo": {
    "name": "Inmigreat",
    "slug": "inmigreat",
    "version": "2.0.13",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "inmigreat",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7FF"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.changayaf.inmigreat",
      "associatedDomains": [
        "applinks:inmigreat.com",
        "applinks:www.inmigreat.com"
      ],
      "infoPlist": {
        "MinimumOSVersion": "13.0",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.changayaf.inmigreat",
      "adaptiveIcon": {
        "backgroundColor": "#EEF3FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "googleServicesFile": "google-services.json",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "inmigreat.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.inmigreat.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "changayaf",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c93bda27-146d-4ea3-b617-c77213c426f5"
    },
    "extra": {
      "eas": {
        "projectId": "c93bda27-146d-4ea3-b617-c77213c426f5"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      "@sentry/react-native"
    ]
  }
}
